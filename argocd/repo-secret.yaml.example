# DSO-702 — Argo CD repository credential (TEMPLATE, placeholders only).
# The PostureSec repo is private, so Argo CD needs read credentials to pull manifests.
# Preferred: create it out-of-band so no credential is ever written to a committed file:
#   kubectl create secret generic posturesec-repo -n argocd \
#     --from-literal=type=git \
#     --from-literal=url=https://github.com/Posture-Cybersecurity/PostureSec-DevSecOps-Lab.git \
#     --from-literal=username='<github-username>' \
#     --from-literal=password='<github-pat-with-repo-read>'
#   kubectl label secret posturesec-repo -n argocd argocd.argoproj.io/secret-type=repository
#
# If you must use a file, copy to argocd/repo-secret.yaml (gitignored) and set real values.
apiVersion: v1
kind: Secret
metadata:
  name: posturesec-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: https://github.com/Posture-Cybersecurity/PostureSec-DevSecOps-Lab.git
  username: "<github-username>"
  password: "<github-pat-with-repo-read-scope>"
