# DSO-705 — template for the PostgreSQL credentials Secret (placeholders only).
# Preferred: create it out-of-band so no credential is ever written to a file:
#   kubectl create secret generic posturesec-db-secret -n posturesec \
#     --from-literal=POSTGRES_USER=posturesec_user \
#     --from-literal=POSTGRES_PASSWORD='<strong-password>' \
#     --from-literal=POSTGRES_DB=posturesec_db
#
# If you must use a file: copy to k8s/posturesec-db-secret.yaml, set real values,
# and DO NOT commit it (that path is gitignored).
apiVersion: v1
kind: Secret
metadata:
  name: posturesec-db-secret
  namespace: posturesec
  labels:
    app.kubernetes.io/part-of: posturesec
type: Opaque
stringData:
  POSTGRES_USER: "posturesec_user"
  POSTGRES_PASSWORD: "CHANGE_ME_use_a_strong_password"
  POSTGRES_DB: "posturesec_db"
