{
  "name": "posturesec-backend",
  "version": "1.0.0",
  "description": "PostureSec — Posture Cybersecurity Platform API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/ --ext .js",
    "test": "jest --runInBand --forceExit",
    "test:remediation": "node -e \"process.env.WARROOM_REMEDIATION='1';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['jest','tests/warroom_remediation.test.js','--runInBand','--forceExit'],{stdio:'inherit',env:process.env})\"",
    "warroom:status": "node src/warroom/cli.js status",
    "warroom:trigger": "node src/warroom/cli.js trigger",
    "warroom:reset": "node src/warroom/cli.js reset"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
