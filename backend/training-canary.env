# ============================================================================
#  ⚠️  SYNTHETIC TRAINING CANARY — War Room INC-003 (Sprint 3 / DSO-W3)
# ============================================================================
#  This file is NOT a real credential.
#
#  The value below authenticates to nothing, grants access to nothing, is never
#  sent anywhere, and must never be treated as a real secret. It exists for ONE
#  reason: to demonstrate, safely, how credential material can be baked into a
#  container image during a build and then recovered from the image's layers.
#
#  It sits in the backend build context on purpose: the INC-003 "vulnerable"
#  image build copies it into the image, so the running container ships a real
#  (synthetic) secret inside a real image layer. The normal, secure backend image
#  (backend/Dockerfile) copies only src/ and never includes this file.
#
#  If a scanner or a reviewer flags this value, that is the exercise working as
#  intended. Do not rotate anything real on account of it.
# ============================================================================
WARROOM_FAKE_SECRET=WARROOM_FAKE_SECRET_a1b2c3d4e5f6_training_only_not_a_real_key
