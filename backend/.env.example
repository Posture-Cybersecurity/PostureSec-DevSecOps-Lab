# Copy this file to .env and adjust if your local setup differs:
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. These values match the `db`
# service in docker-compose.yml, so they work as-is if you start the database
# with `docker compose up -d db`.

# Where Postgres is listening. Use `localhost` when the backend runs on your
# machine; use `db` only when the backend itself runs inside Docker Compose.
DB_HOST=localhost
DB_PORT=5432

DB_USER=posturesec_user
DB_PASSWORD=posturesec_pass_2026
DB_NAME=posturesec_db

# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=5000
