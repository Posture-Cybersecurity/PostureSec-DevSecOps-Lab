{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyInUsEast1",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetConsoleOutput",
        "cloudtrail:LookupEvents",
        "tag:GetResources",
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } }
    },
    {
      "Sid": "ReadUbuntuAmiParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
    },
    {
      "Sid": "LaunchOnlyOwnSquadT3SmallInstanceAndVolume",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:us-east-1:*:instance/*", "arn:aws:ec2:us-east-1:*:volume/*"],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/WarRoomSquad": "${aws:PrincipalTag/WarRoomSquad}",
          "aws:RequestTag/WarRoom": "INC-004"
        },
        "StringEqualsIfExists": { "ec2:InstanceType": "t3.small" }
      }
    },
    {
      "Sid": "LaunchUsingImageSubnetAndNetworkInterface",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:*:subnet/*",
        "arn:aws:ec2:us-east-1:*:network-interface/*"
      ]
    },
    {
      "Sid": "LaunchOnlyIntoOwnSquadSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:*:security-group/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/WarRoomSquad": "${aws:PrincipalTag/WarRoomSquad}" } }
    },
    {
      "Sid": "CreateOnlyOwnSquadSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:*:security-group/*",
      "Condition": { "StringEquals": { "aws:RequestTag/WarRoomSquad": "${aws:PrincipalTag/WarRoomSquad}", "aws:RequestTag/WarRoom": "INC-004" } }
    },
    {
      "Sid": "CreateSecurityGroupInTheVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:*:vpc/*"
    },
    {
      "Sid": "TagOnlyWhileCreating",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:CreateAction": ["RunInstances", "CreateSecurityGroup", "AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress"]
        }
      }
    },
    {
      "Sid": "ProgressTagsOnOwnSquadInstanceOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/WarRoomSquad": "${aws:PrincipalTag/WarRoomSquad}" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["WarRoomPhase", "WarRoomScore"] }
      }
    },
    {
      "Sid": "ChangeOrDeleteOnlyOwnSquadResources",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:ModifyInstanceCreditSpecification",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
        "ec2:UpdateSecurityGroupRuleDescriptionsEgress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:ResourceTag/WarRoomSquad": "${aws:PrincipalTag/WarRoomSquad}"
        }
      }
    },
    {
      "Sid": "TagNewSecurityGroupRulesForOwnSquad",
      "Effect": "Allow",
      "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress"],
      "Resource": "arn:aws:ec2:us-east-1:*:security-group-rule/*",
      "Condition": { "StringEquals": { "aws:RequestTag/WarRoomSquad": "${aws:PrincipalTag/WarRoomSquad}" } }
    },
    {
      "Sid": "PassOnlyOwnSquadInstanceRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/postureblog-ec2-warroom-${aws:PrincipalTag/WarRoomSquad}-ssm",
      "Condition": { "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" } }
    },
    {
      "Sid": "ReadOwnSquadInstanceProfile",
      "Effect": "Allow",
      "Action": ["iam:GetInstanceProfile", "iam:GetRole"],
      "Resource": [
        "arn:aws:iam::*:instance-profile/postureblog-ec2-warroom-${aws:PrincipalTag/WarRoomSquad}-ssm",
        "arn:aws:iam::*:role/postureblog-ec2-warroom-${aws:PrincipalTag/WarRoomSquad}-ssm"
      ]
    },
    {
      "Sid": "RunCommandsOnOwnSquadInstanceOnly",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:StartSession"],
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Condition": { "StringEquals": { "ssm:resourceTag/WarRoomSquad": "${aws:PrincipalTag/WarRoomSquad}" } }
    },
    {
      "Sid": "SsmDocumentsForInspection",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:StartSession"],
      "Resource": [
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript",
        "arn:aws:ssm:us-east-1:*:document/SSM-SessionManagerRunShell"
      ]
    },
    {
      "Sid": "SsmOwnSessions",
      "Effect": "Allow",
      "Action": ["ssm:TerminateSession", "ssm:ResumeSession"],
      "Resource": "arn:aws:ssm:us-east-1:*:session/${aws:username}-*"
    },
    {
      "Sid": "NeverOutsideUsEast1",
      "Effect": "Deny",
      "NotAction": ["sts:GetCallerIdentity", "iam:PassRole", "iam:GetInstanceProfile", "iam:GetRole"],
      "Resource": "*",
      "Condition": { "StringNotEquals": { "aws:RequestedRegion": "us-east-1" } }
    },
    {
      "Sid": "DenyEverythingElseIncludingIamWrites",
      "Effect": "Deny",
      "NotAction": ["iam:PassRole", "iam:GetInstanceProfile", "iam:GetRole", "sts:GetCallerIdentity", "ec2:*", "ssm:*", "cloudtrail:LookupEvents", "tag:GetResources"],
      "Resource": "*"
    }
  ]
}
